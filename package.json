{
  "name": "dsh-repro-kit",
  "version": "0.1.0",
  "description": "Deterministic, privacy-aware minimal repro bundles for DeepSeek Harness sessions",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "agentic",
    "reproduction",
    "debugging",
    "session"
  ],
  "license": "MIT",
  "author": "Linxiushen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linxiushen/dsh-repro-kit.git"
  },
  "homepage": "https://github.com/Linxiushen/dsh-repro-kit#readme",
  "bugs": {
    "url": "https://github.com/Linxiushen/dsh-repro-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "bin": {
    "dsh-repro": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "schemas",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "check:release": "node scripts/check-release.mjs",
    "prepack": "pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm publint"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "oxlint": "1.76.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
